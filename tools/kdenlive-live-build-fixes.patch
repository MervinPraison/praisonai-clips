-    if (parent == QStringLiteral("-1")) {
-        parent = model->getRootFolder()->clipId();
-    }
-
-    QString newId;
-    Fun undo = []() { return true; };
-    Fun redo = []() { return true; };
-    if (model->requestAddFolder(newId, name, parent, undo, redo)) {
-        pCore->pushUndo(undo, redo, i18n("Create folder"));
-        return newId;
-    }
-    return QString();
